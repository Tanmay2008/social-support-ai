# infrastructure/Dockerfile.backend
# Multi-stage build for AI backend
FROM python:3.11-slim as builder

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    software-properties-common \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install Poetry
RUN curl -sSL https://install.python-poetry.org | python3 -
ENV PATH="/root/.local/bin:$PATH"

# Copy project files
WORKDIR /app
COPY pyproject.toml poetry.lock* ./

# Install dependencies
RUN poetry config virtualenvs.create false \
    && poetry install --no-dev --no-interaction --no-ansi

# Runtime stage
FROM python:3.11-slim as runtime

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    curl \
    tesseract-ocr \
    poppler-utils \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -r aiuser && useradd -r -g aiuser aiuser

# Copy Python dependencies from builder
COPY --from=builder /usr/local/lib/python3.11/site-packages/ /usr/local/lib/python3.11/site-packages/
COPY --from=builder /usr/local/bin/ /usr/local/bin/

# Create app directory
WORKDIR /app

# Copy application code
COPY 1_data_pipeline/ ./1_data_pipeline/
COPY 2_ai_agents/ ./2_ai_agents/
COPY 3_ml_models/ ./3_ml_models/
COPY 4_agent_orchestration/ ./4_agent_orchestration/
COPY 5_api_server/ ./5_api_server/
COPY 7_observability/ ./7_observability/
COPY requirements.txt .
COPY run.py .

# Create necessary directories
RUN mkdir -p /app/data /app/models /app/logs /app/uploads \
    && chown -R aiuser:aiuser /app

# Switch to non-root user
USER aiuser

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/api/health || exit 1

# Start application
CMD ["uvicorn", "5_api_server.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]