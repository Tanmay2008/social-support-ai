# infrastructure/Dockerfile.frontend
# Streamlit frontend Dockerfile
FROM python:3.11-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -r frontend && useradd -r -g frontend frontend

# Set working directory
WORKDIR /app

# Copy requirements
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy frontend code
COPY 6_frontend/ ./6_frontend/
COPY run.py .

# Create necessary directories
RUN mkdir -p /app/data /app/logs \
    && chown -R frontend:frontend /app

# Switch to non-root user
USER frontend

# Expose port
EXPOSE 8501

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8501/healthz || exit 1

# Start Streamlit app
CMD ["streamlit", "run", "6_frontend/streamlit_app.py", "--server.port=8501", "--server.address=0.0.0.0"]